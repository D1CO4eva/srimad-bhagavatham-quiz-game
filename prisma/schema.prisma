// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

enum GameSessionStatus {
  LOBBY
  ACTIVE
  COMPLETED
}

/// A quiz authored/generated ahead of time. Editable — live sessions snapshot
/// their own frozen copy of questions at creation time (see GameSessionQuestion).
model Quiz {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions    Question[]
  gameSessions GameSession[]
}

model Question {
  id            String       @id @default(cuid())
  quizId        String
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order         Int
  type          QuestionType
  question      String
  /// Answer choices. Empty for SHORT_ANSWER.
  choices       String[]
  answer        String
  explanation   String       @default("")
  timeLimitSecs Int          @default(20)

  @@unique([quizId, order])
}

/// A live instance of a Quiz, identified by a join PIN. Question order,
/// choices, and timing are frozen at creation via GameSessionQuestion so
/// editing the source Quiz mid-session never affects it (Story 1.2).
model GameSession {
  id        String            @id @default(cuid())
  pin       String
  status    GameSessionStatus @default(LOBBY)
  quizId    String
  quiz      Quiz              @relation(fields: [quizId], references: [id])
  createdAt DateTime          @default(now())
  startedAt DateTime?
  endedAt   DateTime?

  /// Index of the question currently live (-1 before the host advances past the lobby).
  currentQuestionIndex Int @default(-1)

  questions GameSessionQuestion[]
  players   Player[]
  results   SessionResult[]

  /// Only one non-completed session may hold a given PIN at a time; the app
  /// enforces this at creation time (Postgres can't express a partial unique
  /// constraint on status portably through Prisma's schema DSL).
  @@index([pin])
}

model Player {
  id                 String      @id @default(cuid())
  gameSessionId      String
  gameSession        GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  nickname           String
  /// Median ping/pong RTT in ms, used to compensate scoring for network distance (Story 2.2, 4.2).
  estimatedLatencyMs Int?
  joinedAt           DateTime    @default(now())

  answers Answer[]
  results SessionResult[]

  @@unique([gameSessionId, nickname])
  @@index([gameSessionId])
}

model GameSessionQuestion {
  id            String       @id @default(cuid())
  gameSessionId String
  gameSession   GameSession  @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  order         Int
  type          QuestionType
  question      String
  choices       String[]
  answer        String
  explanation   String       @default("")
  timeLimitSecs Int

  /// Set when the host advances to this question (Story 3.1); the countdown
  /// and the server's answer deadline are both computed from this.
  startedAt DateTime?
  /// Set when the question is locked, either by "Lock Now" or by the host's
  /// timer reaching zero (Story 3.5). The deadline check in answer
  /// submission (startedAt + timeLimitSecs) is the real authority (Story
  /// 3.3) — this is a UI signal, not the source of truth.
  lockedAt  DateTime?

  answers Answer[]

  @@unique([gameSessionId, order])
}

model Answer {
  id                    String              @id @default(cuid())
  gameSessionQuestionId String
  gameSessionQuestion   GameSessionQuestion @relation(fields: [gameSessionQuestionId], references: [id], onDelete: Cascade)
  playerId              String
  player                Player              @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /// Index into GameSessionQuestion.choices. Only MULTIPLE_CHOICE/TRUE_FALSE
  /// questions are answerable from the live tap UI (Story 3.2/3.4).
  choiceIndex           Int
  serverReceivedAt      DateTime            @default(now())

  /// Graded at submission time (Story 4.1-4.3) using only server-received
  /// timestamps; rawReactionTimeMs/trueReactionTimeMs are kept for the
  /// formula-correctness audit (QA 9.4), not just points.
  correct            Boolean
  points             Int
  rawReactionTimeMs  Int
  trueReactionTimeMs Int

  @@unique([gameSessionQuestionId, playerId])
}

/// Final standings, written once when the last question's leaderboard phase
/// closes (Story 5.3). Snapshotted from Redis so post-game standings survive
/// even after the session's Redis leaderboard eventually expires.
model SessionResult {
  id            String      @id @default(cuid())
  gameSessionId String
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  playerId      String
  player        Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  nickname      String
  rank          Int
  totalPoints   Int
  createdAt     DateTime    @default(now())

  @@unique([gameSessionId, playerId])
  @@index([gameSessionId])
}
