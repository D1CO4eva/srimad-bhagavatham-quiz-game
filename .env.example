# Copy to .env.local (dev) and fill in real values. Never commit real secrets.

# Local Postgres, matches docker-compose.yml defaults.
DATABASE_URL="postgresql://quiz:quiz@localhost:5432/quiz_dev?schema=public"

# Local Redis, matches docker-compose.yml defaults.
REDIS_URL="redis://localhost:6379"

# Ably (realtime pub/sub). Get a free-tier key at https://ably.com — needed from Feature 6 onward.
ABLY_API_KEY=""

# Base URL used to build shareable join links (e.g. http://localhost:3000 in dev).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# GOD-Auth-Service's course-note RAG quiz generator. Public Cloud Run URL,
# no auth required for callers (same one bhagavatham-class-quiz-generator
# uses) — override only if pointing at a different deployment or local dev.
QUIZ_GENERATOR_API_URL="https://god-auth-service-693007788010.us-central1.run.app/api/quiz/generate"

# Shared passcode the host enters at /host/login to access the host pages.
HOST_PASSCODE=""

# Random secret used to sign the host's session cookie. Generate with:
# openssl rand -base64 32
SESSION_SECRET=""

# Optional: only needed if the target Postgres server's `template1` isn't
# pristine (e.g. it doubles as the app's own database), which would
# otherwise leak existing objects into Prisma's auto-created shadow database
# used by `prisma migrate dev`.
SHADOW_DATABASE_URL=""
