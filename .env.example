# Copy to .env.local (dev) and fill in real values. Never commit real secrets.

# Local Postgres, matches docker-compose.yml defaults.
DATABASE_URL="postgresql://quiz:quiz@localhost:5432/quiz_dev?schema=public"

# Local Redis, matches docker-compose.yml defaults.
REDIS_URL="redis://localhost:6379"

# Ably (realtime pub/sub). Get a free-tier key at https://ably.com — needed from Feature 6 onward.
ABLY_API_KEY=""

# Base URL used to build shareable join links (e.g. http://localhost:3000 in dev).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
