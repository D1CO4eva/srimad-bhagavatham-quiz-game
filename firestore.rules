rules_version = '2';

// All reads/writes happen server-side via the firebase-admin SDK (see
// src/lib/firestore.ts), which bypasses these rules entirely — matching how
// Prisma/Postgres access worked before this migration (server-only, no
// client-side DB access). Deny-all is correct here, not a placeholder.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
